<?xml version="1.0" encoding="UTF-8"?>

<!-- Design and styling implementation for QuadM-->
<ui version="4.0">

<!-- MAIN WINDOW-->
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>700</height>
   </rect>
  </property>

  <!-- Title-->
  <property name="windowTitle">
   <string>QuadM Media Metadata Viewer</string>
  </property>

  <!-- Content area. Basically the canvas itself-->
  <widget class="QWidget" name="centralwidget">

   <!-- Vertical layouting-->
   <!-- Splits the canvas into two rows. the top one for needed buttons and stuff, the bottom to display files/folders/path/metadata and stuff-->
   <layout class="QVBoxLayout" name="mainVerticalLayout">
    <property name="spacing">
     <number>10</number>
    </property>
    <property name="leftMargin">
     <number>12</number>
    </property>
    <property name="topMargin">
     <number>12</number>
    </property>
    <property name="rightMargin">
     <number>12</number>
    </property>
    <property name="bottomMargin">
     <number>12</number>
    </property>

    <!-- The main file viewer and metadata viewer (Huge inspo from Em's and Yannick's images)-->
    <!-- Has three columns: Drives, Contents, and Metadata. -->
    <!-- The contents panel is reused for folder navigation. -->
    <item>
     <widget class="QWidget" name="contentWidget" native="true">
      <layout class="QHBoxLayout" name="contentLayout">
       <property name="spacing">
        <number>10</number>
       </property>
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>

       <!--The left most widget. This where people see the files/ folders listed-->
       <item>
        <widget class="QWidget" name="rootPanel" native="true">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="minimumSize">
          <size>
           <width>180</width>
           <height>0</height>
          </size>
         </property>

         <layout class="QVBoxLayout" name="rootPanelLayout">

          <item>
           <widget class="QLabel" name="rootHeadingLabel">
            <property name="styleSheet">
             <string notr="true">font-weight: bold; font-size: 14px;</string>
            </property>
            <property name="text">
             <string>QuadM Root Directory</string>
            </property>
           </widget>
          </item>

          <!-- DRIVE SELECTION-->
          <!-- Allows users to select between available drives on their device-->
          <item>
           <widget class="QComboBox" name="driveComboBox"/>
          </item>

          <!--File listing for root-->
          <item>
           <widget class="QListWidget" name="rootListWidget">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="viewMode">
             <enum>QListView::ViewMode::ListMode</enum>
            </property>
            <property name="iconSize">
             <size>
              <width>32</width>
              <height>32</height>
             </size>
            </property>
            <property name="uniformItemSizes">
             <bool>true</bool>
            </property>
            <property name="selectionMode">
             <enum>QAbstractItemView::SelectionMode::SingleSelection</enum>
            </property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!--Second panel. Generally hidden, becomes visible when a folder from root is opened to display contents-->
       <!--This panel will be reused to open folders inside folders-->
       <item>
        <widget class="QWidget" name="contentsPanel" native="true">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>

         <layout class="QVBoxLayout" name="contentsPanelLayout">

          <item>
           <layout class="QHBoxLayout" name="contentsHeaderLayout">
            <item>
             <widget class="QPushButton" name="backButton">
              <property name="enabled">
               <bool>true</bool>
              </property>
              <property name="text">
               <string>Back</string>
              </property>
             </widget>
            </item>

            <item>
             <widget class="QLabel" name="currentPathLabel">
              <property name="text">
               <string>Select a folder</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </item>

          <!-- Dynamic file loading, reused-->
          <item>
           <widget class="QListWidget" name="contentsListWidget">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="viewMode">
             <enum>QListView::ViewMode::ListMode</enum>
            </property>
            <property name="iconSize">
             <size>
              <width>32</width>
              <height>32</height>
             </size>
            </property>
            <property name="uniformItemSizes">
             <bool>true</bool>
            </property>
            <property name="selectionMode">
             <enum>QAbstractItemView::SelectionMode::SingleSelection</enum>
            </property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <!-- MetaData panel-->
       <!-- This is where all the metadata extracted from the selected media file will be displayed-->
       <!-- Uses a scroll area so that longer metadata can be displayed without expanding the entire window-->
       <item>
        <widget class="QWidget" name="metadataPanel" native="true">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="minimumSize">
          <size>
           <width>150</width>
           <height>0</height>
          </size>
         </property>

         <layout class="QVBoxLayout" name="metadataPanelLayout">

          <item>
           <widget class="QLabel" name="metadataHeadingLabel">
            <property name="styleSheet">
             <string notr="true">font-weight: bold; font-size: 14px;</string>
            </property>
            <property name="text">
             <string>Metadata</string>
            </property>
           </widget>
          </item>

          <!-- Button to open the complete metadata window-->
          <item>
           <widget class="QPushButton" name="expandMetadataButton">
            <property name="minimumSize">
             <size>
              <width>0</width>
              <height>32</height>
             </size>
            </property>
            <property name="text">
             <string>View All Metadata</string>
            </property>
           </widget>
          </item>

          <!-- Metadata display area-->
          <!-- Expands to use the available space in the window-->
          <item>
           <widget class="QFrame" name="metadataFrame">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="frameShape">
             <enum>QFrame::Shape::StyledPanel</enum>
            </property>
            <property name="frameShadow">
             <enum>QFrame::Shadow::Plain</enum>
            </property>

            <layout class="QVBoxLayout" name="metadataLayout">
             <property name="leftMargin">
              <number>4</number>
             </property>
             <property name="topMargin">
              <number>4</number>
             </property>
             <property name="rightMargin">
              <number>4</number>
             </property>
             <property name="bottomMargin">
              <number>4</number>
             </property>

             <item>

              <!-- Scroll area for metadata-->
              <!-- Allows users to scroll through metadata when there is more information than the panel can display-->
              <widget class="QScrollArea" name="metadataScrollArea">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="frameShape">
                <enum>QFrame::Shape::NoFrame</enum>
               </property>
               <property name="verticalScrollBarPolicy">
                <enum>Qt::ScrollBarPolicy::ScrollBarAsNeeded</enum>
               </property>
               <property name="horizontalScrollBarPolicy">
                <enum>Qt::ScrollBarPolicy::ScrollBarAsNeeded</enum>
               </property>
               <property name="widgetResizable">
                <bool>true</bool>
               </property>

               <!-- The contents inside the scroll area-->
               <widget class="QWidget" name="metadataScrollContents">
                <property name="geometry">
                 <rect>
                  <x>0</x>
                  <y>0</y>
                  <width>280</width>
                  <height>247</height>
                 </rect>
                </property>

                <layout class="QVBoxLayout" name="metadataScrollContentsLayout">
                 <property name="leftMargin">
                  <number>8</number>
                 </property>
                 <property name="topMargin">
                  <number>8</number>
                 </property>
                 <property name="rightMargin">
                  <number>8</number>
                 </property>
                 <property name="bottomMargin">
                  <number>8</number>
                 </property>

                 <item>

                  <!-- Metadata text is displayed here-->
                  <widget class="QLabel" name="metadataPlaceholderLabel">
                   <property name="sizePolicy">
                    <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
                     <horstretch>0</horstretch>
                     <verstretch>0</verstretch>
                    </sizepolicy>
                   </property>
                   <property name="minimumSize">
                    <size>
                     <width>150</width>
                     <height>180</height>
                    </size>
                   </property>
                   <property name="text">
                    <string>OIIA cat loading...</string>
                   </property>
                   <property name="alignment">
                    <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
                   </property>
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                  </widget>
                 </item>

                 <item>
                  <spacer name="metadataContentSpacer">
                   <property name="orientation">
                    <enum>Qt::Orientation::Vertical</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>20</width>
                     <height>20</height>
                    </size>
                   </property>
                  </spacer>
                 </item>

                </layout>
               </widget>
              </widget>
             </item>

            </layout>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

      </layout>
     </widget>
    </item>
   </layout>
  </widget>

  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect>
     <x>0</x>
     <y>0</y>
     <width>1200</width>
     <height>33</height>
    </rect>
   </property>
  </widget>

  <widget class="QStatusBar" name="statusbar"/>
 </widget>

 <resources/>
 <connections/>
</ui>